# --- Core ---
# Public base URL used in emails and absolute links.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://hub:hub@localhost:5432/collab_hub

# --- Auth ---
# When true, publishing actions (posts, opportunities, applications, messages,
# connection requests) require a verified email address.
REQUIRE_EMAIL_VERIFICATION=true
# Days a session stays valid.
SESSION_TTL_DAYS=30

# --- Email ---
# Leave empty in development: emails are stored in the outbox and viewable at /dev/mailbox.
# Example: smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM="BeeHub <no-reply@collabhub.local>"

# --- Uploads ---
# Local directory for user uploads (profile photos, covers, logos, gallery images).
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_MB=5

# --- Logging ---
LOG_LEVEL=info

# Stable key for Server Actions closure encryption when running multiple instances.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Scheduled jobs ---
# Bearer token for POST /api/cron/notification-emails (email digests). Leave empty to disable the endpoint.
CRON_SECRET=
